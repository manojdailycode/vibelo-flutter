# ─────────────────────────────────────────────────────────────────────────
# Local Development Environment Variables
# COPY THIS FILE TO .env AND FILL IN YOUR OWN VALUES
# NEVER COMMIT .env TO GIT — it's in .gitignore for security
# ─────────────────────────────────────────────────────────────────────────

# JioSaavn API (Required)
JIOSAAVN_BASE_URL=https://your-jiosaavn-proxy-url.workers.dev

# YouTube API (Optional, for fallback music search)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Firebase (Optional, if using Firebase services)
# Note: Firebase config is typically auto-loaded from google-services.json on Android
# FIREBASE_API_KEY=your_firebase_api_key
